# ERP backend (FastAPI) the storefront talks to -- server-side only.
STORE_API_BASE=http://localhost:8000

# How the storefront signs in to the backend. Set ONE of these:
#
# 1. The DAAP-hosted storefront (every shop, normal setup): the storefront app's own key, the same value as STOREFRONT_PLATFORM_KEY
#    in the backend. The shop is the address opened: with the backend's STORE_BASE_DOMAIN=localhost, http://rosaya.localhost:3001 is Rosaya.
STOREFRONT_PLATFORM_KEY=
#
# 2. One shop only (a site that serves a single business at any address): that business's 'online' key, e.g. made with
#    cd ../erp-ecommerce-backend && uv run python -m scripts.seed_rosaya --write-env ../storefront/.env.local
#    SITE_URL is then that shop's public address (sitemap, share links).
STORE_CHANNEL_KEY=
SITE_URL=

# public base URL of the R2 bucket that holds uploaded product images (same as the backend MEDIA_BASE_URL)
MEDIA_BASE_URL=
