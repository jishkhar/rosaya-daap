# ERP backend (FastAPI) the storefront talks to -- server-side only.
STORE_API_BASE=http://localhost:8000
# The 'online' channel key of the Rosaya tenant. Create one with:  cd ../backend && uv run python -m scripts.seed_rosaya --write-env ../storefront/.env.local
STORE_CHANNEL_KEY=
# public base URL of the R2 bucket that holds uploaded product images (same as the backend MEDIA_BASE_URL)
MEDIA_BASE_URL=
